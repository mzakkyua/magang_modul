# ====================================================================
# PERHATIAN ADMINISTRATOR SERVER:
# File ini adalah template untuk environment PRODUCTION.
# Pastikan APP_DEBUG bernilai FALSE sebelum aplikasi diakses publik.
# ====================================================================

APP_NAME="SINAKERTRANS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sinakertrans.namadomain.go.id

# Pengaturan bahasa (sudah disesuaikan ke Indonesia)
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# BCRYPT_ROUNDS=12

# Log level diubah ke warning agar error ringan tidak memenuhi disk server
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ====================================================================
# KREDENSIAL DATABASE
# Wajib diubah sesuai dengan pengaturan database di server production!
# ====================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magang_modul
DB_USERNAME=sinakertrans_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_DISINI

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# ====================================================================
# KEAMANAN SESSION (WAJIB HTTPS UNTUK PRODUCTION)
# ====================================================================
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ====================================================================
# PENGATURAN EMAIL (KANTOR POS / SMTP)
# Wajib diisi dengan email resmi dinas/instansi agar fitur Reset Password (Lupa Password) 
# untuk mahasiswa magang dapat berfungsi dan benar-benar terkirim ke inbox mereka.
# ====================================================================
MAIL_MAILER=smtp
MAIL_HOST=mail.namadomain.go.id
MAIL_PORT=587
MAIL_USERNAME=no-reply@namadomain.go.id
MAIL_PASSWORD=GANTI_DENGAN_PASSWORD_EMAIL_ASLI_DISINI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@namadomain.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"